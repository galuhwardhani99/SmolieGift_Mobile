<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCart"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:title="Keranjang Saya"
        app:titleTextColor="#2D3142"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/llDaftarKeranjang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rincian Pembayaran" android:textStyle="bold" android:textSize="16sp" android:textColor="#2D3142" android:layout_marginBottom="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Total Bayar" android:textColor="#64748B"/>
                        <TextView android:id="@+id/tvTotalBayarAkhir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textStyle="bold" android:textSize="18sp" android:textColor="#DD3827"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvLabelNamaPemesan"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EMAIL PEMESAN" android:textSize="10sp" android:textStyle="bold" android:textColor="#64748B" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etNamaPemesan"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="#F5F6F8"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="Email"
                        android:textColor="#2D3142"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/llPaymentMethods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="METODE PEMBAYARAN" android:textSize="10sp" android:textStyle="bold" android:textColor="#64748B" android:layout_marginBottom="8dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                            <Button
                                android:id="@+id/btnMetodeTunai"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="45dp"
                                android:text="Tunai"
                                app:icon="@drawable/money_bill_wave"
                                android:backgroundTint="#0D6EFD"
                                android:textColor="#FFFFFF"
                                app:iconTint="#FFFFFF"
                                android:layout_marginEnd="4dp"
                                app:cornerRadius="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"/>

                            <Button
                                android:id="@+id/btnMetodeQris"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="45dp"
                                android:text="QRIS"
                                app:icon="@drawable/qr"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="#2D3142"
                                android:backgroundTint="#F5F6F8"
                                android:textColor="#2D3142"
                                android:layout_marginStart="4dp"
                                app:cornerRadius="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llKasirPaymentSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UANG DITERIMA" android:textSize="10sp" android:textStyle="bold" android:textColor="#64748B" android:layout_marginBottom="4dp"/>
                        <EditText
                            android:id="@+id/etUangDiterima"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:background="#F5F6F8"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:hint="Masukkan nominal uang"
                            android:inputType="number"
                            android:textColor="#2D3142"
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kembalian" android:textColor="#64748B" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvKembalian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textStyle="bold" android:textSize="16sp" android:textColor="#2E7D32"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llContainerQris"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp"
                        android:background="#F5F6F8"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Silakan Scan QR Code di bawah ini:"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>

                        <ImageView
                            android:id="@+id/ivQrCode"
                            android:layout_width="250dp"
                            android:layout_height="350dp"
                            android:src="@drawable/qris"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnKonfirmasi"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Konfirmasi Pesanan →"
                        android:backgroundTint="#DD3827"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        app:cornerRadius="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>