<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STRUK PEMBAYARAN"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2D3142"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="350dp"
            android:background="#F1F5F9"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvIsiStruk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Isi Struk..."
                android:textColor="#1E293B"
                android:typeface="monospace"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnPrintStruk"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRINT"
                android:layout_marginEnd="8dp"
                app:icon="@android:drawable/ic_menu_share"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btnSimpanPdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PDF"
                app:icon="@android:drawable/ic_menu_save"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnTutupStruk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="TUTUP &amp; KEMBALI"
            android:backgroundTint="#DD3827"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>