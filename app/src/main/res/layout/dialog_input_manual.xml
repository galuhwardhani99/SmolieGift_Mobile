<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaksi Manual Toko"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#DD3827"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pembeli"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/etManualNamaPembeli"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Masukkan nama pembeli"
            android:background="@drawable/bg_spinner"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:inputType="textPersonName"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih dari Katalog"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="8dp"/>
        <AutoCompleteTextView
            android:id="@+id/actvManualProduk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Cari produk di katalog..."
            android:background="@drawable/bg_spinner"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:completionThreshold="1"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/etManualNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nama produk"
            android:background="@drawable/bg_spinner"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harga Satuan (Rp)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/etManualHarga"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Harga"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:inputType="number"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qty"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp"/>
                <EditText
                    android:id="@+id/etManualQty"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Jml"
                    android:background="@drawable/bg_spinner"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:text="1"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catatan Pesanan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/etManualCatatan"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Contoh: Custom tulisan Happy Wedding"
            android:background="@drawable/bg_spinner"
            android:padding="12dp"
            android:textSize="14sp"
            android:gravity="top"
            android:layout_marginBottom="24dp"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/btnGenerateQR"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="GENERATE QR CODE"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp"
            android:elevation="4dp"/>

        <ImageView
            android:id="@+id/ivManualQR"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:contentDescription="QR Code Transaksi"/>

        <Button
            android:id="@+id/btnSimpanTransaksiManual"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SIMPAN TRANSAKSI MANUAL"
            android:backgroundTint="#DD3827"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnManualBatal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATAL"
            android:backgroundTint="#F1F5F9"
            android:textColor="#475569"
            android:layout_marginTop="8dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>
</ScrollView>