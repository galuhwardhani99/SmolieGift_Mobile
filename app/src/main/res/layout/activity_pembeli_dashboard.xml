<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPembeli"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:title="Smolie Gift"
        app:titleTextColor="#DD3827"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/contentFramePembeli"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarPembeli"
        app:layout_constraintBottom_toTopOf="@id/bottomNavPembeli">

        <ScrollView
            android:id="@+id/layoutHomePembeli"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="32dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#DD3827"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cari Souvenir Unik &amp; Cantik?"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Temukan beragam pilihan custom souvenir di sini!"
                            android:textAlignment="center"
                            android:textColor="#FFEBEE"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llKasirActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnInputManualBaru"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:text="Input Manual"
                        android:backgroundTint="#2D3142"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="8dp"
                        app:icon="@drawable/edit"
                        app:iconTint="#FFFFFF"/>

                    <Button
                        android:id="@+id/btnLihatKeranjangKasir"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:text="Keranjang"
                        android:backgroundTint="#DD3827"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/shopping_cart"
                        app:iconTint="#FFFFFF"/>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF">
                    <AutoCompleteTextView
                        android:id="@+id/acSearchProduk"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@android:color/transparent"
                        android:hint="Cari souvenir favoritmu..."
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#2D3142"
                        android:textSize="14sp"
                        android:completionThreshold="1"/>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnLihatKeranjang"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Keranjang Belanja"
                    app:icon="@drawable/shopping_cart"
                    app:iconGravity="textStart"
                    android:backgroundTint="#FFF5F5"
                    android:textColor="#DD3827"
                    app:iconTint="#DD3827"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="24dp"
                    android:elevation="2dp"/>

                <TextView
                    android:id="@+id/tvLabelKatalog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Katalog Produk"
                    android:textColor="#2D3142"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="16dp"/>

                <GridLayout
                    android:id="@+id/glDaftarProdukPembeli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/fragmentContainerPembeli"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ✅ Layout Map dengan Tombol Lokasi Saya -->
        <FrameLayout
            android:id="@+id/layoutLocationPembeli"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <org.osmdroid.views.MapView
                android:id="@+id/mapOsm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:src="@drawable/ic_my_location"
                app:backgroundTint="#FFFFFF"
                app:tint="#DD3827"
                app:fabSize="normal" />

        </FrameLayout>

        <ScrollView
            android:id="@+id/layoutProfilePembeli"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_person"
                        app:tint="#DD3827"
                        android:padding="20dp"
                        android:scaleType="centerInside"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Pembeli"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#2D3142"/>

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textSize="16sp"
                    android:textColor="#64748B"
                    android:layout_marginBottom="32dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    android:backgroundTint="#FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Informasi Akun"
                            android:textStyle="bold"
                            android:textColor="#2D3142"
                            android:textSize="16sp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/tvProfileUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Username: -"
                            android:textColor="#64748B"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tvProfileGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jenis Kelamin: -"
                            android:textColor="#64748B"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tvProfilePhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telepon: -"
                            android:textColor="#64748B"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tvProfileAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alamat: -"
                            android:textColor="#64748B"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavPembeli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:menu="@menu/pembeli_bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>