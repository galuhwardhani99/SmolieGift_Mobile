<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beri Ulasan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvReviewKode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaksi: #INV-0000"
            android:textColor="#64748B"
            android:layout_marginBottom="24dp"/>

        <!-- Bagian Rating -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <RatingBar
            android:id="@+id/ratingBarReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="5"
            android:progressTint="#DD3827"
            android:layout_marginBottom="20dp"
            style="?android:attr/ratingBarStyle"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tulis ulasan Anda..."
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="20dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lampiran Foto"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmbilFoto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Kamera"
                app:icon="@drawable/camera"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPilihFoto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Galeri"
                app:icon="@drawable/image"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">
            <ImageView
                android:id="@+id/ivReviewPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lampiran Video"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPilihVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Video dari Galeri"
            app:icon="@drawable/video"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVideoPreview"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <VideoView
                    android:id="@+id/vvReviewVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"/>

                <LinearLayout
                    android:id="@+id/llVideoControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:background="#CC000000"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <SeekBar
                        android:id="@+id/sbVideoProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="#FFFFFF"
                        android:thumbTint="#FFFFFF"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btnVideoRewind"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/rewind"
                            app:tint="#FFFFFF"/>
                        <ImageButton
                            android:id="@+id/btnVideoPlayPause"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/play"
                            app:tint="#FFFFFF"/>
                        <ImageButton
                            android:id="@+id/btnVideoForward"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/fast_forward"
                            app:tint="#FFFFFF"/>
                        <ImageButton
                            android:id="@+id/btnVideoStop"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/stop"
                            app:tint="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="KIRIM ULASAN"
            android:backgroundTint="#DD3827"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
