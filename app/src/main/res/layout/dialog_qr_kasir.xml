<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCAN STRUK DIGITAL"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#2D3142"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:background="#FFFFFF"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvUrlStruk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minta pelanggan scan QR ini"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvStatusQR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR Siap di-scan"
            android:textStyle="bold"
            android:textColor="#15803D"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/progressPolling"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnKonfirmasiBayar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="KONFIRMASI SELESAI"
            android:backgroundTint="#166534"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnBatalQR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATAL"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#64748B"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>