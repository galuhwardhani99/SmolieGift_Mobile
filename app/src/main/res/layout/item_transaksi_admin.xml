<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Status & ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F5F9"
                app:contentPaddingLeft="12dp"
                app:contentPaddingRight="12dp"
                app:contentPaddingTop="6dp"
                app:contentPaddingBottom="6dp">
                <TextView
                    android:id="@+id/tvAdminTransStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PESANAN AKTIF"
                    android:textColor="#475569"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"/>
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvAdminTransId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#INV-0000"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Customer Name & Amount -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tvAdminTransNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pemesan"
                android:textColor="#1E293B"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvAdminTransTotal"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvAdminTransTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#DD3827"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- Products List -->
        <TextView
            android:id="@+id/tvAdminTransProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar produk belanjaan..."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"/>

        <!-- Note Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8FAFC"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/edit"
                app:tint="#94A3B8"/>
            <TextView
                android:id="@+id/tvAdminTransCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Catatan: -"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="italic"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Image Container (Restored for AdminLaporan & History) -->
        <LinearLayout
            android:id="@+id/llContainerImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lampiran Gambar:"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">
                <ImageView
                    android:id="@+id/ivCustomDesignAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Additional Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/tvAdminTransWa" android:layout_width="wrap_content" android:text="WhatsApp" android:textColor="#94A3B8" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:text=" • " android:textColor="#CBD5E1"/>
            <TextView android:id="@+id/tvAdminTransMetode" android:layout_width="wrap_content" android:text="Tunai" android:textColor="#94A3B8" android:textSize="11sp"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/tvAdminTransTanggal" android:layout_width="wrap_content" android:text="Waktu" android:textColor="#94A3B8" android:textSize="11sp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCetakStruk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:text="SIMPAN PDF"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/receipt"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                android:backgroundTint="#475569"
                android:layout_marginEnd="8dp"
                android:elevation="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelesaiPesanan"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="54dp"
                android:text="SELESAIKAN"
                android:backgroundTint="#DD3827"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:elevation="2dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>